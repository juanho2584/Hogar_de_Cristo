# ==============================================================================
# HOGAR DE DIOS - Variables de Entorno de Ejemplo
# ==============================================================================
# IMPORTANTE:
# 1. Copia este archivo como .env para desarrollo local: cp .env.example .env
# 2. Reemplaza los valores con los de tu proyecto Supabase (Project Settings > API).
# 3. NUNCA coloques la clave 'service_role' en este archivo ni en el frontend.
#    Solo se utiliza 'anon' (pública con RLS activo).
# ==============================================================================

# URL base del proyecto Supabase
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública 'anon' (Row Level Security gestionará la autorización real)
VITE_SUPABASE_ANON_KEY=tu-clave-anon-publica-aqui

# Nombre de la aplicación
VITE_APP_NAME="Hogar de Dios - Gestión Académica"
